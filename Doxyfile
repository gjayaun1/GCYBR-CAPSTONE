# ===============================
# Doxygen configuration (GDScript)
# ===============================

PROJECT_NAME           = "GCYBER: Capstone Project"
PROJECT_NUMBER         = v1.0
PROJECT_BRIEF          = "Cybersecurity education application implemented in Godot."

# Run from repo root
OUTPUT_DIRECTORY       = gcybr-capstone-game/docs

# ---- INPUT ----
INPUT                  = gcybr-capstone-game
RECURSIVE              = YES

# Include GDScript
FILE_PATTERNS          = *.gd *.md
EXTENSION_MAPPING      = gd=C++

# Extract everything (important for lightly-commented code)
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# ---- HTML OUTPUT ----
GENERATE_HTML          = YES
HTML_OUTPUT            = .
HTML_DYNAMIC_MENUS     = YES
HTML_SEARCH            = YES

# ---- DIAGRAMS (Graphviz) ----
HAVE_DOT               = YES
CLASS_DIAGRAMS         = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

# ---- QUIETNESS ----
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO

# ---- MARKDOWN ----
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md
SHOW_FILES = YES
